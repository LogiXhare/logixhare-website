---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Motion from '../components/Motion.astro';
import { url } from '../lib/url';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const pageTitle = `${title} — LogiXhare Technologies`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/jpeg" href={url('/icon.jpg')} />
    <link rel="apple-touch-icon" href={url('/icon.jpg')} />
    <meta name="generator" content={Astro.generator} />

    <meta name="theme-color" content="#f4f8fb" />

    {/* Applies the saved theme before first paint. Must stay inline and in
        <head>: deferred to the body it would render one frame of the wrong
        theme. The stamp is always written explicitly, never left off for the
        default, so the toggle and the logo/icon swaps can read one value
        rather than treating "absent" as a third state. Light is the default,
        so no saved choice — and an unreadable localStorage — both land on
        light. The OS prefers-color-scheme setting is deliberately NOT
        consulted: the default is a brand decision. */}
    <script is:inline>
      var t = 'light';
      try {
        if (localStorage.getItem('lx-theme') === 'dark') t = 'dark';
      } catch (e) {
        /* private mode / storage blocked — the light default is correct anyway */
      }
      document.documentElement.dataset.theme = t;
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LogiXhare Technologies" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/logo.jpg', Astro.site)} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main" class="visually-hidden">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Motion />
  </body>
</html>
