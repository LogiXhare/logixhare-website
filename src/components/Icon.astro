---
// Minimal hand-drawn line icon set — 24x24, stroke-based, currentColor.
// Kept intentionally small and simple (no icon library) for a lightweight,
// consistent mark language across the site.
interface Props {
  name:
    | 'server'
    | 'code'
    | 'network'
    | 'cloud'
    | 'shield'
    | 'chart'
    | 'check'
    | 'mail'
    | 'phone'
    | 'pin'
    | 'menu'
    | 'close'
    | 'arrow-right';
  class?: string;
}

const { name, class: className } = Astro.props;
---

{
  name === 'server' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <rect x="3.5" y="3.5" width="17" height="6" rx="1.4" />
      <rect x="3.5" y="14.5" width="17" height="6" rx="1.4" />
      <circle cx="7" cy="6.5" r="0.9" fill="currentColor" stroke="none" />
      <circle cx="7" cy="17.5" r="0.9" fill="currentColor" stroke="none" />
      <line x1="10.5" y1="6.5" x2="16.5" y2="6.5" />
      <line x1="10.5" y1="17.5" x2="16.5" y2="17.5" />
    </svg>
  )
}
{
  name === 'code' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <polyline points="8.5 8 4.5 12 8.5 16" />
      <polyline points="15.5 8 19.5 12 15.5 16" />
      <line x1="13.2" y1="5.5" x2="10.8" y2="18.5" />
    </svg>
  )
}
{
  name === 'network' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <circle cx="12" cy="5" r="2" />
      <circle cx="5" cy="18" r="2" />
      <circle cx="19" cy="18" r="2" />
      <line x1="12" y1="7" x2="6.2" y2="16.3" />
      <line x1="12" y1="7" x2="17.8" y2="16.3" />
      <line x1="7" y1="18" x2="17" y2="18" />
    </svg>
  )
}
{
  name === 'cloud' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <path d="M7.5 17.5h9a3.5 3.5 0 0 0 0-7 5 5 0 0 0-9.5-1.8A3.5 3.5 0 0 0 7.5 17.5Z" />
    </svg>
  )
}
{
  name === 'shield' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <path d="M12 3.5 19 6v5.5c0 4.2-2.9 7-7 9-4.1-2-7-4.8-7-9V6l7-2.5Z" />
      <polyline points="9 12 11.2 14.2 15.2 10" />
    </svg>
  )
}
{
  name === 'chart' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <polyline points="4 16 9.5 10.5 13.5 14.5 20 7" />
      <polyline points="14.5 7 20 7 20 12.5" />
    </svg>
  )
}
{
  name === 'check' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <polyline points="4.5 12.5 9.5 17.5 19.5 6.5" />
    </svg>
  )
}
{
  name === 'mail' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <rect x="3.5" y="5.5" width="17" height="13" rx="1.6" />
      <polyline points="4.5 7 12 12.5 19.5 7" />
    </svg>
  )
}
{
  name === 'phone' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <path d="M6.2 4.5h2.9l1.3 3.6-1.9 1.7a11.4 11.4 0 0 0 5.7 5.7l1.7-1.9 3.6 1.3v2.9c0 1-1 1.7-2 1.5-4-1-9.6-6.6-10.6-10.6-.2-1 .5-2 1.3-2.2Z" />
    </svg>
  )
}
{
  name === 'pin' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <path d="M12 21s-6.5-5.7-6.5-11A6.5 6.5 0 0 1 18.5 10c0 5.3-6.5 11-6.5 11Z" />
      <circle cx="12" cy="10" r="2.3" />
    </svg>
  )
}
{
  name === 'menu' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" class={className} aria-hidden="true">
      <line x1="4" y1="7" x2="20" y2="7" />
      <line x1="4" y1="12" x2="20" y2="12" />
      <line x1="4" y1="17" x2="20" y2="17" />
    </svg>
  )
}
{
  name === 'close' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" class={className} aria-hidden="true">
      <line x1="5.5" y1="5.5" x2="18.5" y2="18.5" />
      <line x1="18.5" y1="5.5" x2="5.5" y2="18.5" />
    </svg>
  )
}
{
  name === 'arrow-right' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <line x1="4.5" y1="12" x2="18" y2="12" />
      <polyline points="12.5 6.5 18 12 12.5 17.5" />
    </svg>
  )
}
