---
import Icon from './Icon.astro';
import { serviceCategories } from '../data/nav';
import { url } from '../lib/url';

const year = new Date().getFullYear();

// Contact cards. LogiXhare runs one office — this is that office, split by
// how people actually reach us, rather than padded out with invented branches.
const contactCards = [
  {
    icon: 'pin' as const,
    label: 'Head office',
    lines: ['H: 25, R: 12, DIT Project', 'South Baridhara R/A', 'Merul Badda, Badda', 'Dhaka 1212, Bangladesh'],
  },
  {
    icon: 'phone' as const,
    label: 'Sales',
    note: 'Business enquiries',
    lines: ['+880 1714-682259'],
    href: 'tel:+8801714682259',
  },
  {
    icon: 'phone' as const,
    label: 'Support',
    note: 'Customer care / help desk',
    lines: ['+880 1915-749496'],
    href: 'tel:+8801915749496',
  },
  {
    icon: 'mail' as const,
    label: 'Email us',
    lines: ['info@logixhare.com'],
    href: 'mailto:info@logixhare.com',
  },
];

const companyLinks = [
  { label: 'About us', href: url('/about/') },
  { label: 'Services', href: url('/services/') },
  { label: 'Contact', href: url('/contact/') },
];

// One representative link per service category, so the footer stays scannable
// instead of reprinting the whole mega-menu.
const serviceLinks = serviceCategories.map((cat) => ({
  label: cat.label,
  href: url(`/services/#${cat.id}`),
}));

const clientLinks = [
  { label: 'Client billing portal', href: 'https://billing.logixhare.com/', external: true },
  { label: 'Hosting plans & pricing', href: 'https://billing.logixhare.com/', external: true },
  { label: 'Request support', href: url('/contact/') },
];

// Social profiles. These carry each network's own brand mark rather than going
// through Icon.astro: that set is stroked interface art and isometric objects,
// and a brand logo is neither — it has to be the official filled glyph or it
// stops being recognisable. Add a network by adding a row here; the markup and
// styling below need no change. Only accounts that actually exist go in.
const socials = [
  {
    label: 'Facebook',
    href: 'https://www.facebook.com/logixhare',
    path: 'M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z',
  },
];
---

<footer class="site-footer">
  <!-- Contact strip -->
  <div class="container contact-strip">
    {
      contactCards.map((card) => (
        <div class="contact-card card">
          <span class="icon-tile">
            <Icon name={card.icon} />
          </span>
          <div>
            <span class="contact-label">{card.label}</span>
            {card.href ? (
              <a href={card.href} class="contact-value">
                {card.lines[0]}
              </a>
            ) : (
              card.lines.map((line) => <p class="contact-value">{line}</p>)
            )}
            {card.note && <p class="contact-note">{card.note}</p>}
          </div>
        </div>
      ))
    }
  </div>

  <div class="container footer-grid">
    <div class="footer-brand">
      {/* Two variants, same as the header — the source art can't work on both
          grounds through CSS alone. */}
      <img
        src={url('/logo-dark.png')}
        alt="LogiXhare Technologies"
        width="200"
        height="67"
        class="footer-logo footer-logo-dark"
      />
      <img
        src={url('/logo-light.png')}
        alt=""
        aria-hidden="true"
        width="200"
        height="67"
        class="footer-logo footer-logo-light"
      />
      <p class="footer-tagline">
        Hosting, networks and software for Bangladeshi businesses — built and supported from Dhaka,
        by the engineers who run it.
      </p>
      <a href="https://billing.logixhare.com/" class="btn btn-ghost footer-portal" target="_blank" rel="noopener noreferrer">
        Client portal <Icon name="arrow-right" class="btn-icon" />
      </a>

      <ul class="footer-social">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`LogiXhare Technologies on ${s.label}`}
              >
                {/* Brand marks are single filled paths, unlike the stroked
                    set Icon.astro renders. */}
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={s.path} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <nav class="footer-col" aria-label="Company">
      <span class="footer-heading">Company</span>
      <ul>{companyLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>

    <nav class="footer-col" aria-label="Services">
      <span class="footer-heading">Services</span>
      <ul>{serviceLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>

    <nav class="footer-col" aria-label="Clients">
      <span class="footer-heading">Clients</span>
      <ul>
        {
          clientLinks.map((l) => (
            <li>
              <a
                href={l.href}
                target={l.external ? '_blank' : undefined}
                rel={l.external ? 'noopener noreferrer' : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {year} LogiXhare Technologies. All rights reserved.</p>
    <p class="footer-reg">Dhaka, Bangladesh</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-alt);
    border-top: 1px solid var(--line);
    padding-top: clamp(3rem, 2.4rem + 2vw, 4.5rem);
  }

  /* --- contact strip --- */

  .contact-strip {
    display: grid;
    /* Address gets the extra width: it wraps to two long lines, the phones don't. */
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 1.1rem;
    padding-bottom: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .contact-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.4rem;
  }

  .contact-label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--teal);
    margin-bottom: 0.5rem;
  }

  .contact-value {
    display: block;
    font-size: var(--text-sm);
    color: var(--text);
    line-height: 1.55;
    transition: color 0.15s ease;
  }

  /* A phone number split at its hyphen reads as two numbers. */
  a.contact-value {
    white-space: nowrap;
  }

  a.contact-value:hover {
    color: var(--teal);
  }

  .contact-note {
    margin-top: 0.2rem;
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* --- link grid --- */

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1.3fr 1.2fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }

  .footer-logo {
    height: 34px;
    width: auto;
    margin-bottom: 1rem;
  }

  .footer-logo-dark {
    display: none;
  }

  :global(:root[data-theme='dark']) .footer-logo-light {
    display: none;
  }

  :global(:root[data-theme='dark']) .footer-logo-dark {
    display: block;
  }

  .footer-tagline {
    color: var(--text-muted);
    font-size: var(--text-sm);
    max-width: 34ch;
    line-height: 1.65;
  }

  .footer-portal {
    margin-top: 1.4rem;
    padding: 0.7em 1.3em;
  }

  .footer-social {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.4rem;
  }

  .footer-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--text-muted);
    transition: color 0.18s ease, border-color 0.18s ease, background-color 0.18s ease,
      transform 0.18s ease;
  }

  .footer-social a:hover {
    color: var(--teal);
    border-color: rgba(45, 199, 201, 0.45);
    background: var(--surface-2);
    transform: translateY(-2px);
  }

  .footer-social svg {
    width: 19px;
    height: 19px;
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-social a,
    .footer-social a:hover {
      transition: none;
      transform: none;
    }
  }

  .footer-heading {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text);
    margin-bottom: 1rem;
  }

  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .footer-col a {
    font-size: var(--text-sm);
    color: var(--text-muted);
    transition: color 0.15s ease;
  }

  .footer-col a:hover {
    color: var(--teal);
  }

  /* --- bottom bar --- */

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .footer-bottom p {
    font-size: var(--text-xs);
    color: var(--text-soft);
  }

  .footer-reg {
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
  }

  @media (max-width: 1100px) {
    .contact-strip {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .contact-strip > :first-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 900px) {
    .contact-strip {
      grid-template-columns: 1fr;
    }

    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
