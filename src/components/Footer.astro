---
import Icon from './Icon.astro';

const year = new Date().getFullYear();

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/services/', label: 'Services' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <img src="/logo.jpg" alt="LogixHare Technologies" width="200" height="50" class="footer-logo" />
      <p class="footer-tagline">Web hosting, software, and IT infrastructure — built and supported from Dhaka.</p>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <span class="footer-heading">Site</span>
      <ul>
        {navItems.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer-contact">
      <span class="footer-heading">Contact</span>
      <ul>
        <li>
          <a href="mailto:info@logixhare.com">
            <Icon name="mail" class="footer-icon" /> info@logixhare.com
          </a>
        </li>
        <li>
          <a href="tel:+8801915749496">
            <Icon name="phone" class="footer-icon" /> +880 1915‑749496
          </a>
        </li>
        <li class="footer-address">
          <Icon name="pin" class="footer-icon" />
          <span>101, Gulshan Avenue, Gulshan, Dhaka&nbsp;1212</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {year} LogixHare Technologies. All rights reserved.</p>
    <a href="https://billing.logixhare.com/" target="_blank" rel="noopener noreferrer">Client billing portal</a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--bg);
    padding-top: clamp(2.75rem, 2.2rem + 2vw, 4rem);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.2fr;
    gap: 2.5rem;
    padding-bottom: 2.75rem;
  }

  .footer-logo {
    height: 34px;
    width: auto;
    margin-bottom: 0.9rem;
  }

  .footer-tagline {
    color: var(--slate);
    font-size: var(--text-sm);
    max-width: 32ch;
    line-height: 1.6;
  }

  .footer-heading {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--slate);
    margin-bottom: 0.9rem;
  }

  .footer-nav ul,
  .footer-contact ul {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-nav a,
  .footer-contact a {
    font-size: var(--text-sm);
    color: var(--navy);
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .footer-nav a:hover,
  .footer-contact a:hover {
    color: var(--teal-deep);
  }

  .footer-contact li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
  }

  .footer-contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .footer-address {
    color: var(--slate);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  /* Icon.astro renders its <svg> as a child component, so it never
     receives this file's Astro scope hash — :global() is required
     for the selector to actually match it. */
  .footer-contact :global(.footer-icon) {
    width: 16px;
    height: 16px;
    color: var(--teal-deep);
    flex-shrink: 0;
    margin-top: 0.15em;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1.4rem;
    border-top: 1px solid var(--line);
  }

  .footer-bottom p {
    font-size: var(--text-xs);
    color: var(--slate);
  }

  .footer-bottom a {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--teal-deep);
  }

  .footer-bottom a:hover {
    color: var(--navy);
  }

  @media (max-width: 720px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
