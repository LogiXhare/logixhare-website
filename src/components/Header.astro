---
import Icon from './Icon.astro';

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/services/', label: 'Services' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="container header-row">
    <a href="/" class="brand" aria-label="LogixHare Technologies — home">
      <img src="/logo.jpg" alt="LogixHare Technologies" class="brand-mark" width="220" height="55" />
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a href="/contact/" class="btn btn-primary header-cta">Get in touch</a>
      <button type="button" class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav-mobile">
        <Icon name="menu" class="icon-menu" />
        <Icon name="close" class="icon-close" />
        <span class="visually-hidden">Toggle navigation menu</span>
      </button>
    </div>
  </div>

  <nav class="nav-mobile" id="nav-mobile" aria-label="Primary mobile">
    <ul>
      {
        navItems.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
      <li><a href="/contact/" class="btn btn-primary nav-mobile-cta">Get in touch</a></li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(245, 248, 250, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.85rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .brand-mark {
    height: 40px;
    width: auto;
  }

  .nav-desktop ul {
    display: flex;
    align-items: center;
    gap: 2.1rem;
  }

  .nav-desktop a {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--slate);
    position: relative;
    padding-block: 0.3rem;
    transition: color 0.15s ease;
  }

  .nav-desktop a:hover {
    color: var(--navy);
  }

  .nav-desktop a[aria-current='page'] {
    color: var(--navy);
  }

  .nav-desktop a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    background: var(--teal);
    border-radius: 2px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .header-cta {
    padding: 0.7em 1.35em;
    font-size: var(--text-sm);
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--navy);
    cursor: pointer;
  }

  .nav-toggle :global(svg) {
    width: 20px;
    height: 20px;
  }

  .nav-toggle :global(.icon-close) {
    display: none;
  }

  .nav-toggle[aria-expanded='true'] :global(.icon-menu) {
    display: none;
  }

  .nav-toggle[aria-expanded='true'] :global(.icon-close) {
    display: block;
  }

  .nav-mobile {
    display: none;
    border-top: 1px solid var(--line);
    background: var(--bg);
  }

  .nav-mobile ul {
    display: flex;
    flex-direction: column;
    padding: 1rem clamp(1.25rem, 4vw, 2.5rem) 1.5rem;
    gap: 0.35rem;
  }

  .nav-mobile a {
    display: block;
    padding: 0.75rem 0.25rem;
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--navy);
    border-bottom: 1px solid var(--line);
  }

  .nav-mobile a[aria-current='page'] {
    color: var(--teal-deep);
  }

  .nav-mobile-cta {
    margin-top: 0.75rem;
    text-align: center;
    justify-content: center;
    border-bottom: none !important;
  }

  @media (max-width: 860px) {
    .nav-desktop {
      display: none;
    }

    .header-cta {
      display: none;
    }

    .nav-toggle {
      display: inline-flex;
    }

    .site-header.is-open .nav-mobile {
      display: block;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const header = document.querySelector('.site-header');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    header?.classList.toggle('is-open', !expanded);
  });

  document.querySelectorAll('.nav-mobile a').forEach((link) => {
    link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      header?.classList.remove('is-open');
    });
  });
</script>
