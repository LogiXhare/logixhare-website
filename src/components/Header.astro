---
import Icon from './Icon.astro';
import { navItems, serviceCategories } from '../data/nav';
import { url } from '../lib/url';

const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
// Compare against the base-prefixed path, so "current" still resolves on the
// /staging/ preview build where every route sits one level deeper.
const isActive = (href: string) =>
  href === '/'
    ? currentPath.replace(/\/+$/, '') === base
    : currentPath.startsWith(`${base}${href}`);
---

<header class="site-header" id="site-header">
  <div class="container header-row">
    <a href={url('/')} class="brand" aria-label="LogixHare Technologies — home">
      <img src={url('/logo-dark.png')} alt="LogixHare Technologies" class="brand-mark" width="220" height="73" />
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      <ul>
        {
          navItems.map((item) =>
            item.mega ? (
              <li class="has-mega">
                <button
                  type="button"
                  class="mega-trigger"
                  id="mega-trigger"
                  aria-expanded="false"
                  aria-controls="mega-panel"
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                  <Icon name="chevron-down" class="mega-chevron" />
                </button>
              </li>
            ) : (
              <li>
                <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a
        href="https://billing.logixhare.com/"
        class="portal-link"
        target="_blank"
        rel="noopener noreferrer">Client portal</a
      >
      <a href={url('/contact/')} class="btn btn-primary header-cta">Contact us</a>
      <button
        type="button"
        class="nav-toggle"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="nav-mobile"
      >
        <Icon name="menu" class="icon-menu" />
        <Icon name="close" class="icon-close" />
        <span class="visually-hidden">Toggle navigation menu</span>
      </button>
    </div>
  </div>

  <!-- Desktop mega-menu: category rail on the left, that category's items on the right. -->
  <div class="mega" id="mega-panel" hidden>
    <div class="container mega-inner">
      <ul class="mega-rail" role="tablist" aria-label="Service categories">
        {
          serviceCategories.map((cat, i) => (
            <li>
              <button
                type="button"
                role="tab"
                class="mega-tab"
                data-cat={cat.id}
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={`mega-cat-${cat.id}`}
              >
                <span class="mega-tab-icon">
                  <Icon name={cat.icon} />
                </span>
                {cat.label}
              </button>
            </li>
          ))
        }
        <li class="mega-rail-foot">
          <a href={url('/services/')} class="mega-all">
            All services <Icon name="arrow-right" class="btn-icon" />
          </a>
        </li>
      </ul>

      <div class="mega-panels">
        {
          serviceCategories.map((cat, i) => (
            <div
              class="mega-cat"
              id={`mega-cat-${cat.id}`}
              role="tabpanel"
              data-cat={cat.id}
              hidden={i !== 0}
            >
              <p class="mega-summary">{cat.summary}</p>
              <ul class="mega-items">
                {cat.items.map((item) => (
                  <li>
                    <a href={url(item.href)}>
                      <span class="mega-item-icon">
                        <Icon name={item.icon} />
                      </span>
                      <span class="mega-item-text">
                        <strong>{item.label}</strong>
                        <small>{item.blurb}</small>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Mobile nav: the same data, as an accordion. -->
  <nav class="nav-mobile" id="nav-mobile" aria-label="Primary mobile">
    <ul>
      <li><a href={url('/')}>Home</a></li>
      {
        serviceCategories.map((cat) => (
          <li class="m-group">
            <button type="button" class="m-group-toggle" aria-expanded="false">
              {cat.label}
              <Icon name="chevron-down" class="m-chevron" />
            </button>
            <ul class="m-sub">
              {cat.items.map((item) => (
                <li>
                  <a href={url(item.href)}>{item.label}</a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
      <li><a href={url('/services/')}>All services</a></li>
      <li><a href={url('/about/')}>About</a></li>
      <li><a href={url('/contact/')}>Contact</a></li>
      <li>
        <a href="https://billing.logixhare.com/" target="_blank" rel="noopener noreferrer"
          >Client portal</a
        >
      </li>
      <li><a href={url('/contact/')} class="btn btn-primary nav-mobile-cta">Contact us</a></li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: rgba(6, 13, 24, 0.86);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.8rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .brand-mark {
    height: 38px;
    width: auto;
  }

  .nav-desktop ul {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-desktop a,
  .mega-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--slate);
    background: none;
    border: 0;
    padding: 0.3rem 0;
    cursor: pointer;
    position: relative;
    transition: color 0.15s ease;
  }

  .nav-desktop a:hover,
  .mega-trigger:hover,
  .mega-trigger[aria-expanded='true'] {
    color: var(--on-dark);
  }

  .nav-desktop a[aria-current='page'],
  .mega-trigger[aria-current='page'] {
    color: var(--on-dark);
  }

  .nav-desktop a[aria-current='page']::after,
  .mega-trigger[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    background: var(--teal);
    border-radius: 2px;
  }

  .mega-chevron {
    width: 14px;
    height: 14px;
    transition: transform 0.2s ease;
  }

  .mega-trigger[aria-expanded='true'] .mega-chevron {
    transform: rotate(180deg);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .portal-link {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--slate);
    transition: color 0.15s ease;
  }

  .portal-link:hover {
    color: var(--teal);
  }

  .header-cta {
    padding: 0.7em 1.4em;
    font-size: var(--text-sm);
  }

  /* --- mega-menu --- */

  .mega {
    position: absolute;
    inset: 100% 0 auto 0;
    background: var(--navy-deep);
    border-block: 1px solid var(--line);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.9);
  }

  .mega-inner {
    display: grid;
    grid-template-columns: minmax(0, 270px) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    padding-block: 1.75rem 2rem;
  }

  .mega-rail {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    border-right: 1px solid var(--line);
    padding-right: clamp(1rem, 2vw, 1.75rem);
  }

  .mega-tab {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    text-align: left;
    padding: 0.7rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    background: transparent;
    color: var(--slate);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.3;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .mega-tab:hover {
    color: var(--on-dark);
    background: var(--surface);
  }

  .mega-tab[aria-selected='true'] {
    background: var(--teal-wash);
    border-color: rgba(45, 199, 201, 0.3);
    color: var(--on-dark);
  }

  .mega-tab-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: var(--surface-2);
    color: var(--teal);
    flex-shrink: 0;
  }

  .mega-tab-icon :global(svg) {
    width: 18px;
    height: 18px;
  }

  .mega-rail-foot {
    margin-top: auto;
    padding-top: 0.9rem;
  }

  .mega-all {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding-left: 0.85rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--teal);
  }

  .mega-summary {
    color: var(--slate);
    font-size: var(--text-sm);
    max-width: 60ch;
    margin-bottom: 1.25rem;
  }

  .mega-items {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.4rem 1rem;
  }

  .mega-items a {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    padding: 0.7rem;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .mega-items a:hover {
    background: var(--surface);
    border-color: var(--line);
  }

  .mega-item-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--surface-2);
    color: var(--teal);
    flex-shrink: 0;
  }

  .mega-item-icon :global(svg) {
    width: 17px;
    height: 17px;
  }

  .mega-item-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .mega-item-text strong {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--on-dark);
    line-height: 1.35;
  }

  .mega-item-text small {
    font-size: 0.78rem;
    color: var(--on-dark-muted);
    line-height: 1.4;
  }

  /* --- mobile nav --- */

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--on-dark);
    cursor: pointer;
  }

  .nav-toggle :global(svg) {
    width: 20px;
    height: 20px;
  }

  .nav-toggle :global(.icon-close) {
    display: none;
  }

  .nav-toggle[aria-expanded='true'] :global(.icon-menu) {
    display: none;
  }

  .nav-toggle[aria-expanded='true'] :global(.icon-close) {
    display: block;
  }

  .nav-mobile {
    display: none;
    border-top: 1px solid var(--line);
    background: var(--navy-deep);
    max-height: calc(100vh - 70px);
    overflow-y: auto;
  }

  .nav-mobile > ul {
    display: flex;
    flex-direction: column;
    padding: 0.75rem clamp(1.25rem, 4vw, 2.5rem) 1.5rem;
  }

  .nav-mobile > ul > li > a,
  .m-group-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.85rem 0.25rem;
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--on-dark);
    background: none;
    border: 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    cursor: pointer;
  }

  .m-chevron {
    width: 16px;
    height: 16px;
    color: var(--teal);
    transition: transform 0.2s ease;
  }

  .m-group-toggle[aria-expanded='true'] .m-chevron {
    transform: rotate(180deg);
  }

  .m-sub {
    display: none;
    padding: 0.4rem 0 0.7rem 0.9rem;
    border-left: 2px solid var(--line);
    margin: 0.5rem 0 0.5rem 0.25rem;
  }

  .m-group-toggle[aria-expanded='true'] + .m-sub {
    display: block;
  }

  .m-sub a {
    display: block;
    padding: 0.45rem 0;
    font-size: var(--text-sm);
    color: var(--slate);
  }

  .m-sub a:hover {
    color: var(--teal);
  }

  .nav-mobile-cta {
    margin-top: 1rem;
    justify-content: center;
    border-bottom: none !important;
    color: var(--ink) !important;
  }

  @media (max-width: 1000px) {
    .portal-link {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .nav-desktop,
    .header-cta,
    .mega {
      display: none !important;
    }

    .nav-toggle {
      display: inline-flex;
    }

    .site-header.is-open .nav-mobile {
      display: block;
    }
  }
</style>

<script>
  // --- mobile drawer ---
  const toggle = document.getElementById('nav-toggle');
  const header = document.getElementById('site-header');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    header?.classList.toggle('is-open', !open);
  });

  document.querySelectorAll<HTMLButtonElement>('.m-group-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
    });
  });

  // --- desktop mega-menu ---
  const trigger = document.getElementById('mega-trigger');
  const panel = document.getElementById('mega-panel');

  const setMega = (open: boolean) => {
    trigger?.setAttribute('aria-expanded', String(open));
    if (panel) panel.hidden = !open;
  };

  trigger?.addEventListener('click', () => {
    setMega(trigger.getAttribute('aria-expanded') !== 'true');
  });

  // Close on outside click and on Escape, so the panel never traps the page.
  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (!panel?.contains(target) && !trigger?.contains(target)) setMega(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMega(false);
  });

  // Category rail switches which panel is shown.
  document.querySelectorAll<HTMLButtonElement>('.mega-tab').forEach((tab) => {
    const activate = () => {
      document.querySelectorAll<HTMLButtonElement>('.mega-tab').forEach((t) => {
        t.setAttribute('aria-selected', String(t === tab));
      });
      document.querySelectorAll<HTMLElement>('.mega-cat').forEach((cat) => {
        cat.hidden = cat.dataset.cat !== tab.dataset.cat;
      });
    };
    tab.addEventListener('mouseenter', activate);
    tab.addEventListener('focus', activate);
    tab.addEventListener('click', activate);
  });
</script>
