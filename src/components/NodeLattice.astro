---
// Decorative network-node lattice — echoes the connective, node-based
// language of the LX mark without reproducing it. Pure geometry: circles
// (nodes) joined by short lines (links), a couple of nodes pulse gently
// to suggest a live network. Respects prefers-reduced-motion globally.
---

<svg
  class="node-lattice"
  viewBox="0 0 420 420"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <g stroke="url(#lx-line)" stroke-width="1.1" opacity="0.55">
    <line x1="70" y1="80" x2="170" y2="50" />
    <line x1="170" y1="50" x2="290" y2="90" />
    <line x1="170" y1="50" x2="150" y2="160" />
    <line x1="70" y1="80" x2="150" y2="160" />
    <line x1="290" y1="90" x2="340" y2="190" />
    <line x1="290" y1="90" x2="230" y2="200" />
    <line x1="150" y1="160" x2="230" y2="200" />
    <line x1="150" y1="160" x2="90" y2="240" />
    <line x1="230" y1="200" x2="340" y2="190" />
    <line x1="230" y1="200" x2="260" y2="310" />
    <line x1="90" y1="240" x2="180" y2="330" />
    <line x1="180" y1="330" x2="260" y2="310" />
    <line x1="340" y1="190" x2="370" y2="290" />
    <line x1="260" y1="310" x2="370" y2="290" />
    <line x1="90" y1="240" x2="60" y2="340" />
  </g>

  <g fill="#2dc7c9">
    <circle cx="170" cy="50" r="3.5" opacity="0.9" />
    <circle cx="290" cy="90" r="3" opacity="0.8" />
    <circle cx="340" cy="190" r="3.5" class="pulse" opacity="0.9" />
    <circle cx="230" cy="200" r="3" opacity="0.75" />
    <circle cx="150" cy="160" r="3" opacity="0.75" />
    <circle cx="70" cy="80" r="3" opacity="0.7" />
    <circle cx="90" cy="240" r="3" opacity="0.75" />
    <circle cx="260" cy="310" r="3.5" class="pulse" opacity="0.9" />
    <circle cx="180" cy="330" r="3" opacity="0.7" />
    <circle cx="370" cy="290" r="3" opacity="0.75" />
    <circle cx="60" cy="340" r="2.6" opacity="0.6" />
  </g>

  <defs>
    <linearGradient id="lx-line" x1="0" y1="0" x2="420" y2="420" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#2dc7c9" />
      <stop offset="1" stop-color="#8fb7cf" />
    </linearGradient>
  </defs>
</svg>

<style>
  .node-lattice {
    width: 100%;
    height: 100%;
  }

  .pulse {
    animation: lx-pulse 3.6s ease-in-out infinite;
  }

  .pulse:nth-of-type(2) {
    animation-delay: 1.4s;
  }

  @keyframes lx-pulse {
    0%,
    100% {
      opacity: 0.55;
      r: 3px;
    }
    50% {
      opacity: 1;
      r: 5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse {
      animation: none;
    }
  }
</style>
