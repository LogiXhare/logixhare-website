---
interface Props {
  heading: string;
  body: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  heading,
  body,
  primaryHref = '/contact/',
  primaryLabel = 'Get in touch',
  secondaryHref = '/services/',
  secondaryLabel = 'View services',
} = Astro.props;
---

<section class="cta-band">
  <div class="container cta-inner">
    <div class="cta-lattice" aria-hidden="true"></div>
    <div class="cta-copy">
      <h2>{heading}</h2>
      <p>{body}</p>
    </div>
    <div class="cta-actions">
      <a href={primaryHref} class="btn btn-on-dark">{primaryLabel}</a>
      {secondaryLabel && <a href={secondaryHref} class="btn btn-ghost-on-dark">{secondaryLabel}</a>}
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: var(--navy-deep);
    background-image: radial-gradient(circle at 12% 20%, rgba(45, 199, 201, 0.16), transparent 55%);
    color: var(--on-dark);
    position: relative;
    overflow: hidden;
  }

  .cta-inner {
    position: relative;
    padding-block: clamp(3rem, 2.5rem + 2vw, 4.5rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .cta-copy {
    max-width: 40ch;
  }

  .cta-copy h2 {
    color: #ffffff;
  }

  .cta-copy p {
    margin-top: 0.85rem;
    color: var(--on-dark-muted);
    font-size: var(--text-base);
    line-height: 1.6;
  }

  .cta-actions {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .cta-lattice {
    position: absolute;
    inset: -20% -5% auto auto;
    width: 340px;
    height: 340px;
    background-image: radial-gradient(circle, rgba(45, 199, 201, 0.5) 1.5px, transparent 1.5px);
    background-size: 26px 26px;
    opacity: 0.18;
    pointer-events: none;
  }
</style>
