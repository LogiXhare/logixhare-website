---
import Icon from './Icon.astro';
import type { IconName } from '../data/icons';
import { url } from '../lib/url';

interface Props {
  icon: IconName;
  title: string;
  description: string;
  href: string;
  image?: string;
  imageAlt?: string;
  /** Set on cards near the fold so their artwork does not pop in on scroll. */
  eager?: boolean;
}

const { icon, title, description, href, image, imageAlt = '', eager = false } = Astro.props;
---

<a class="service-card card tilt" href={url(href)}>
  {
    image && (
      <span class="service-art">
        <img
          src={url(image)}
          alt={imageAlt}
          width="640"
          height="400"
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      </span>
    )
  }
  <span class="service-body">
    <span class="icon-tile"><Icon name={icon} /></span>
    <h3>{title}</h3>
    <p>{description}</p>
    <span class="service-link">
      Explore more <Icon name="arrow-right" class="service-link-icon" />
    </span>
  </span>
</a>

<style>
  /* The lift, the tilt and their transitions come from .tilt in global.css —
     a transform here would simply overwrite the one tracking the pointer. */
  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  /* Icon, heading, copy and link all sit on the card's centre line. Centring
     the icon alone would leave it floating over a left-aligned block, so the
     whole body is centred and the row of cards reads as one composed object. */
  .service-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.95rem;
    padding: 1.9rem;
    flex: 1;
  }

  .service-body h3 {
    text-wrap: balance;
  }

  /* Always dark in both themes, so one artwork works on either ground and a
     photograph can replace it later without a second variant. */
  .service-art {
    display: block;
    border-bottom: 1px solid var(--line);
    background: linear-gradient(155deg, #0b1c31, #0e2740 60%, #081524);
    overflow: hidden;
  }

  /* The hover transform lives in global.css beside the tilt, so the artwork
     and the card it sits in are driven from one place. */
  .service-art img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .service-art img {
      transition: none;
    }
  }

  /* Accent wash that only shows on hover — keeps the resting grid calm. */
  .service-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 15% 0%, rgba(45, 199, 201, 0.14), transparent 60%);
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }

  .service-card:hover {
    border-color: rgba(45, 199, 201, 0.4);
    background: var(--surface-2);
  }

  .service-card:hover::before {
    opacity: 1;
  }

  .service-card > * {
    position: relative;
  }

  .service-card p {
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.7;
    /* Centred copy strands a last short word on its own line; pretty pulls
       one back up. Ignored by browsers that don't support it. */
    text-wrap: pretty;
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    margin-top: auto;
    padding-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--teal);
  }

  .service-link :global(.service-link-icon) {
    width: 14px;
    height: 14px;
    transition: transform 0.2s ease;
  }

  .service-card:hover .service-link :global(.service-link-icon) {
    transform: translateX(4px);
  }
</style>
