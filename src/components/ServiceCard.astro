---
import Icon from './Icon.astro';

interface Props {
  icon: 'server' | 'code' | 'network' | 'cloud' | 'shield' | 'chart';
  title: string;
  description: string;
  href: string;
}

const { icon, title, description, href } = Astro.props;
---

<a class="service-card card" href={href}>
  <span class="icon-tile"><Icon name={icon} /></span>
  <h3>{title}</h3>
  <p>{description}</p>
  <span class="service-link">
    Learn more <Icon name="arrow-right" class="service-link-icon" />
  </span>
</a>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.75rem;
    height: 100%;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .service-card:hover {
    transform: translateY(-3px);
    border-color: rgba(45, 199, 201, 0.45);
    box-shadow: 0 18px 34px -20px rgba(21, 42, 74, 0.32);
  }

  .service-card p {
    color: var(--slate);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: auto;
    padding-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--teal-deep);
  }

  .service-link :global(.service-link-icon) {
    width: 14px;
    height: 14px;
    transition: transform 0.2s ease;
  }

  .service-card:hover .service-link :global(.service-link-icon) {
    transform: translateX(3px);
  }
</style>
