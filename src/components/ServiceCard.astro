---
import Icon from './Icon.astro';
import type { IconName } from '../data/icons';
import { url } from '../lib/url';

interface Props {
  icon: IconName;
  title: string;
  description: string;
  href: string;
}

const { icon, title, description, href } = Astro.props;
---

<a class="service-card card" href={url(href)}>
  <span class="icon-tile"><Icon name={icon} /></span>
  <h3>{title}</h3>
  <p>{description}</p>
  <span class="service-link">
    Explore more <Icon name="arrow-right" class="service-link-icon" />
  </span>
</a>

<style>
  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
    padding: 1.9rem;
    height: 100%;
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  /* Accent wash that only shows on hover — keeps the resting grid calm. */
  .service-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 15% 0%, rgba(45, 199, 201, 0.14), transparent 60%);
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }

  .service-card:hover {
    transform: translateY(-4px);
    border-color: rgba(45, 199, 201, 0.4);
    background: var(--surface-2);
  }

  .service-card:hover::before {
    opacity: 1;
  }

  .service-card > * {
    position: relative;
  }

  .service-card p {
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    margin-top: auto;
    padding-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--teal);
  }

  .service-link :global(.service-link-icon) {
    width: 14px;
    height: 14px;
    transition: transform 0.2s ease;
  }

  .service-card:hover .service-link :global(.service-link-icon) {
    transform: translateX(4px);
  }
</style>
