---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const contactMethods = [
  {
    icon: 'mail' as const,
    label: 'Email',
    value: 'info@logixhare.com',
    href: 'mailto:info@logixhare.com',
  },
  {
    icon: 'phone' as const,
    label: 'Phone',
    value: '+880 1915‑749496',
    href: 'tel:+8801915749496',
  },
  {
    icon: 'pin' as const,
    label: 'Address',
    value: '101, Gulshan Avenue, Gulshan, Dhaka – 1212',
    href: null,
  },
];

const serviceOptions = [
  'General inquiry',
  'Web Hosting',
  'Email, Domains & DNS',
  'Web Design & Development',
  'Web Application Development',
  'Server Management',
  'Networks & Automation',
  'Security & Monitoring',
  'SEO & Digital Marketing',
];
---

<BaseLayout
  title="Contact"
  description="Get in touch with LogixHare Technologies — email info@logixhare.com, call +8801915749496, or visit us in Gulshan, Dhaka."
>
  <section class="page-intro">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1 class="display">Let’s talk about what you need</h1>
      <p class="lede">Reach us directly — no ticket portal, no call centre. Use whichever channel works for you.</p>
    </div>
  </section>

  <section class="section contact-section">
    <div class="container contact-grid">
      <div class="contact-info">
        <ul class="contact-list">
          {
            contactMethods.map((method) => (
              <li>
                <span class="icon-tile"><Icon name={method.icon} /></span>
                <div>
                  <span class="contact-label">{method.label}</span>
                  {method.href ? (
                    <a href={method.href} class="contact-value contact-value-link">{method.value}</a>
                  ) : (
                    <span class="contact-value">{method.value}</span>
                  )}
                </div>
              </li>
            ))
          }
        </ul>

        <div class="contact-billing-note card">
          <h3>Already a client?</h3>
          <p>Manage your hosting plan, invoices, and support tickets in the billing portal.</p>
          <a href="https://billing.logixhare.com/" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
            Open billing portal <Icon name="arrow-right" class="btn-icon" />
          </a>
        </div>
      </div>

      <div class="contact-form-wrap card">
        <h2>Send a message</h2>
        <p class="form-intro">
          Fill this in and it opens your email client with everything pre-filled, ready to send to
          info@logixhare.com.
        </p>
        <form id="contact-form" class="contact-form">
          <div class="field-row">
            <label class="field">
              <span>Name</span>
              <input type="text" name="name" required autocomplete="name" />
            </label>
            <label class="field">
              <span>Email</span>
              <input type="email" name="email" required autocomplete="email" />
            </label>
          </div>
          <label class="field">
            <span>What's this about?</span>
            <select name="service">
              {serviceOptions.map((option) => <option value={option}>{option}</option>)}
            </select>
          </label>
          <label class="field">
            <span>Message</span>
            <textarea name="message" rows="5" required></textarea>
          </label>
          <button type="submit" class="btn btn-primary">
            Open in email client <Icon name="arrow-right" class="btn-icon" />
          </button>
          <p class="form-note">
            This form isn't wired to a server — submitting it opens your own email app with a message addressed
            to info@logixhare.com. Prefer to write directly? Use <a href="mailto:info@logixhare.com">info@logixhare.com</a> instead.
          </p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-intro {
    padding-block: clamp(2.5rem, 2rem + 2.5vw, 4rem) clamp(1.5rem, 1.2rem + 1vw, 2.5rem);
  }

  .page-intro h1 {
    margin-top: 0.75rem;
    max-width: 22ch;
  }

  .page-intro .lede {
    margin-top: 1.1rem;
  }

  .contact-section {
    padding-top: 0.5rem;
    padding-bottom: clamp(3.5rem, 3rem + 2vw, 5.5rem);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: start;
  }

  .contact-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact-list li {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .contact-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
  }

  .contact-value {
    display: block;
    font-weight: 700;
    font-size: var(--text-base);
    color: var(--text);
  }

  .contact-value-link:hover {
    color: var(--teal);
  }

  .contact-billing-note {
    margin-top: 2.25rem;
    padding: 1.5rem;
  }

  .contact-billing-note h3 {
    margin-bottom: 0.5rem;
  }

  .contact-billing-note p {
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin-bottom: 1.1rem;
  }

  .contact-form-wrap {
    padding: clamp(1.75rem, 1.5rem + 1vw, 2.5rem);
  }

  .form-intro {
    color: var(--text-muted);
    font-size: var(--text-sm);
    margin-top: 0.5rem;
    margin-bottom: 1.75rem;
    line-height: 1.6;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.15rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text);
  }

  .field input,
  .field select,
  .field textarea {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--text);
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.75em 0.9em;
    resize: vertical;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: 2px solid var(--teal);
    outline-offset: 1px;
    border-color: var(--teal);
  }

  .contact-form .btn {
    align-self: flex-start;
    margin-top: 0.35rem;
  }

  .form-note {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .form-note a {
    color: var(--teal);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .field-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    const data = new FormData(form);
    const name = String(data.get('name') || '').trim();
    const email = String(data.get('email') || '').trim();
    const service = String(data.get('service') || 'General inquiry');
    const message = String(data.get('message') || '').trim();

    const subject = `Website inquiry — ${service}`;
    const body = `Name: ${name}\nEmail: ${email}\nRegarding: ${service}\n\n${message}`;

    const mailto = `mailto:info@logixhare.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    window.location.href = mailto;
  });
</script>
