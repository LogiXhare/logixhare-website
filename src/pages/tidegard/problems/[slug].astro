---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { problemTypes, problemSlug, type ProblemType } from '../../../data/tidegard-problems';
import { url } from '../../../lib/url';

export function getStaticPaths() {
  return problemTypes.map((p) => ({ params: { slug: problemSlug(p.code) }, props: { problem: p } }));
}

const { problem } = Astro.props as { problem: ProblemType };
const typeUri = `https://logixhare.com/tidegard/problems/${problemSlug(problem.code)}`;

// What a client should generally do, by status class. The specific meaning
// above it says what went wrong; this says what to do about it.
const advice =
  problem.status === 409
    ? 'Re-read the resource, decide again with its current state, and send a new request. Do not resend the same one unchanged.'
    : problem.status === 429 || problem.status === 503
      ? 'Wait for the time in the Retry-After header, then retry the same request with the same Idempotency-Key.'
      : problem.status >= 500
        ? 'Retry later. If it persists, give the request_id from the response to your Tidegard administrator.'
        : problem.status === 401 || problem.status === 403
          ? 'Check the token and its role. Retrying the same request will not change the answer.'
          : 'Fix the request; retrying it unchanged will get the same answer.';
---

<BaseLayout
  title={`${problem.code} · Tidegard API`}
  description={`Tidegard API problem type ${problem.code}, HTTP ${problem.status}.`}
>
  <section class="section problem">
    <div class="container problem-inner">
      <p class="eyebrow">Tidegard API problem type</p>
      <h1><code>{problem.code}</code></h1>
      <dl class="problem-facts card">
        <div>
          <dt>HTTP status</dt>
          <dd>{problem.status}</dd>
        </div>
        <div>
          <dt>error</dt>
          <dd><code>{problem.code}</code></dd>
        </div>
        <div>
          <dt>type</dt>
          <dd><code>{typeUri}</code></dd>
        </div>
      </dl>

      <h2>What it means</h2>
      <p class="problem-meaning" set:html={problem.meaning} />

      <h2>What to do</h2>
      <p>{advice}</p>

      <p class="problem-links">
        <a href={url('/tidegard/problems/')}>All problem types</a>
        <a href={url('/tidegard/docs/api/')}>REST API guide</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .problem-inner {
    max-width: 820px;
  }

  h1 {
    margin-top: 0.7rem;
    font-size: clamp(1.6rem, 1.3rem + 1.4vw, 2.4rem);
    overflow-wrap: anywhere;
  }

  h1 code {
    font-family: var(--font-mono);
    font-weight: 600;
  }

  h2 {
    font-size: var(--text-xl);
    margin-top: 2.25rem;
    margin-bottom: 0.6rem;
  }

  p {
    color: var(--text-muted);
  }

  .problem-facts {
    display: grid;
    gap: 0.9rem;
    margin: 1.75rem 0 0;
    padding: 1.25rem 1.4rem;
  }

  .problem-facts div {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 1rem;
  }

  dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: none;
    color: var(--text-soft);
    padding-top: 0.15rem;
  }

  dd {
    margin: 0;
    color: var(--text);
    overflow-wrap: anywhere;
  }

  code,
  .problem-meaning :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .problem-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .problem-links a {
    color: var(--teal);
    font-weight: 700;
  }

  @media (max-width: 560px) {
    .problem-facts div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.2rem;
    }
  }
</style>
