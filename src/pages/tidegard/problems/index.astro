---
/**
 * The registry the Tidegard API's problem `type` URIs point at:
 * https://logixhare.com/tidegard/problems/<code with . and _ as ->.
 * The API documents those URIs as identifiers that need not resolve; this
 * makes them resolve anyway, so a developer who follows one lands somewhere
 * useful.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { problemTypes, problemSlug } from '../../../data/tidegard-problems';
import { url } from '../../../lib/url';

const groups = [
  { prefix: 'api.', label: 'Requests and access' },
  { prefix: 'incident.', label: 'Incidents' },
  { prefix: 'mitigation.', label: 'Mitigations' },
  { prefix: 'tenant.', label: 'Tenants' },
  { prefix: 'token.', label: 'Tokens' },
].map((g) => ({ ...g, items: problemTypes.filter((p) => p.code.startsWith(g.prefix)) }));
---

<BaseLayout
  title="API problem types · Tidegard"
  description="Every error code the Tidegard REST API returns, with its HTTP status and meaning."
>
  <section class="section problems">
    <div class="container">
      <p class="eyebrow">Tidegard API</p>
      <h1>Problem types</h1>
      <p class="lede">
        Every error from the Tidegard REST API is an RFC 9457 problem document with a stable
        <code>error</code> code. Its <code>type</code> links to the code's page here. Switch on
        <code>error</code>, never on the title or detail text. A code, once published, never changes
        meaning.
      </p>
      <p class="problems-back">
        <a href={url('/tidegard/docs/api/')}>Read the REST API guide</a>
      </p>

      {
        groups.map((g) => (
          <div class="problem-group">
            <h2>{g.label}</h2>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Code</th>
                    <th>Status</th>
                    <th>Meaning</th>
                  </tr>
                </thead>
                <tbody>
                  {g.items.map((p) => (
                    <tr>
                      <td>
                        <a href={url(`/tidegard/problems/${problemSlug(p.code)}/`)}>
                          <code>{p.code}</code>
                        </a>
                      </td>
                      <td>{p.status}</td>
                      <td set:html={p.meaning} />
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .problems h1 {
    margin-top: 0.7rem;
  }

  .problems .lede {
    margin-top: 1rem;
  }

  .problems-back {
    margin-top: 1rem;
  }

  .problems-back a,
  td a {
    color: var(--teal);
    font-weight: 700;
  }

  .problem-group {
    margin-top: 2.75rem;
  }

  .problem-group h2 {
    font-size: var(--text-xl);
    margin-bottom: 1rem;
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.93rem;
  }

  th,
  td {
    padding: 0.7rem 0.9rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
    color: var(--text-muted);
  }

  tr:last-child td {
    border-bottom: 0;
  }

  th {
    color: var(--text);
    background: var(--surface-2);
    font-weight: 700;
  }

  code,
  td :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    color: var(--text);
    white-space: nowrap;
  }

  td :global(code) {
    white-space: normal;
  }

  td:first-child code {
    white-space: nowrap;
  }
</style>
