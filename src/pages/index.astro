---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { serviceCategories } from '../data/nav';
import { url } from '../lib/url';

// Counted rather than written down, so the figure can't go stale when the
// services data changes.
const serviceCount = serviceCategories.reduce((n, cat) => n + cat.items.length, 0);

// Each homepage card reuses its category's artwork, so replacing the file in
// nav.ts updates both this grid and the services page.
const artFor = new Map(serviceCategories.map((cat) => [cat.id, cat]));

// --- hero rotator ---
// Each slide leads with a different capability, the way a company with more
// than one line of work introduces itself. Copy is deliberately concrete.
const slides = [
  {
    eyebrow: 'Managed web hosting',
    art: 'hosting',
    heading: 'Hosting you never have to chase support about',
    body: 'Websites, mail and databases on infrastructure we own and run ourselves — with published pricing and a portal you can actually self-serve from.',
  },
  {
    eyebrow: 'Web design & development',
    art: 'web',
    heading: 'Websites built around how your business really works',
    body: 'Custom sites and web applications, designed and written to fit your process instead of bending your process around a template.',
  },
  {
    eyebrow: 'Software & ERP',
    art: 'software',
    heading: 'Business software modelled on your process, not a template',
    body: 'ERP, HRM, CRM, POS and industry platforms — including RMG ERP and ISP billing — built to match how your organisation already runs.',
  },
  {
    eyebrow: 'Networks & infrastructure',
    art: 'network',
    heading: 'Network and server work, done the way operators do it',
    body: 'Design, automation, hardening and monitoring — the same discipline used on carrier networks, applied at the size your business needs.',
  },
];

const standards = [
  { icon: 'lock' as const, title: 'Free SSL', note: 'Issued, installed and auto-renewed on every plan.' },
  { icon: 'server' as const, title: 'NVMe storage', note: 'Solid-state throughout, not spinning disk.' },
  { icon: 'refresh' as const, title: 'Scheduled backups', note: 'Taken on a schedule, restorable on request.' },
  { icon: 'phone' as const, title: 'Direct support', note: 'You reach the engineers, not a call queue.' },
];

const stack = ['Ubuntu LTS', 'Nginx', 'HestiaCP', 'MariaDB', "Let's Encrypt", 'Cloudflare'];

// One card per service category. The ninth tile in this 3x3 grid is the
// "everything else" link, rendered separately below.
const services = [
  {
    icon: 'server' as const,
    title: 'Hosting & Infrastructure',
    description:
      'NVMe-backed hosting, business email, domains and DNS, server setup and backups — provisioned from our own portal.',
    href: '/services/#web-hosting',
    cat: 'hosting',
  },
  {
    icon: 'code' as const,
    title: 'Web & eCommerce',
    description:
      'Corporate websites, online stores and web applications, designed and built around how your business operates.',
    href: '/services/#web-development',
    cat: 'web',
  },
  {
    icon: 'database' as const,
    title: 'Software Development',
    description:
      'ERP, HRM, CRM, POS and industry platforms — including RMG ERP and ISP billing, built to fit your process.',
    href: '/services/#erp',
    cat: 'software',
  },
  {
    icon: 'network' as const,
    title: 'IT & Networking',
    description:
      'Network design and cabling, firewalls, VPN and SD-WAN, Wi-Fi, CCTV and IP telephony — plus the automation to keep it consistent.',
    href: '/services/#network-consulting',
    cat: 'network',
  },
  {
    icon: 'cloud' as const,
    title: 'Cloud & Data Center',
    description:
      'Virtualisation, SAN/NAS storage, cloud migration, colocation and data centre design, with disaster recovery you have rehearsed.',
    href: '/services/#virtualisation',
    cat: 'datacenter',
  },
  {
    icon: 'shield' as const,
    title: 'Cyber Security',
    description:
      'Penetration testing, hardening, endpoint and ransomware protection, and audits mapped to ISO 27001, PCI-DSS or GDPR.',
    href: '/services/#security',
    cat: 'security',
  },
  {
    icon: 'search' as const,
    title: 'Digital & Media',
    description:
      'SEO, social and paid campaigns, analytics, branding and graphic design, and video and motion graphics production.',
    href: '/services/#seo',
    cat: 'growth',
  },
  {
    icon: 'compass' as const,
    title: 'Consultancy & Managed IT',
    description:
      'IT planning and gap analysis, SLA-based managed support, remote helpdesk, and training that leaves your team able to run it.',
    href: '/services/#managed-support',
    cat: 'consulting',
  },
];

// The sectors this work lands in. Named because the systems genuinely differ
// between them — not a claim about who we have already invoiced.
const industries = [
  {
    icon: 'building' as const,
    title: 'Government & public sector',
    body: 'Procurement-ready documentation, auditable systems and infrastructure that stays in the country.',
  },
  {
    icon: 'lock' as const,
    title: 'Banking & financial',
    body: 'Hardened infrastructure, encryption and compliance evidence for regulated environments.',
  },
  {
    icon: 'heart' as const,
    title: 'Healthcare & hospitals',
    body: 'Hospital management systems, patient record handling and the uptime a clinical service needs.',
  },
  {
    icon: 'book' as const,
    title: 'Education & eLearning',
    body: 'Campus administration, school management systems, and networks that survive a full lab of students.',
  },
  {
    icon: 'cart' as const,
    title: 'Retail & eCommerce',
    body: 'Storefronts, POS and inventory tied together, on hosting sized for a sale day rather than an average one.',
  },
  {
    icon: 'box' as const,
    title: 'Manufacturing & RMG',
    body: 'RMG ERP, production and store flows, and the factory-floor networks underneath them.',
  },
  {
    icon: 'pin' as const,
    title: 'Real estate & construction',
    body: 'Property and project management systems, plus site connectivity and surveillance.',
  },
  {
    icon: 'network' as const,
    title: 'ISPs & telecom',
    body: 'Subscriber billing, network automation and monitoring — operator-scale change discipline.',
  },
];

// The platform we operate for our own clients. Real systems, not a portfolio
// of client logos — this is what a customer is actually buying into.
const platform = [
  {
    icon: 'server' as const,
    title: 'Managed hosting platform',
    body: 'Control panel accounts, isolated per client, with quotas on disk, bandwidth, databases and mailboxes.',
  },
  {
    icon: 'monitor' as const,
    title: 'Self-service billing portal',
    body: 'Plans, invoices and sign-up live at billing.logixhare.com — no back-and-forth to see what something costs.',
  },
  {
    icon: 'mail' as const,
    title: 'Business email',
    body: 'Mailboxes on your own domain, with webmail, and the DNS records set correctly for deliverability.',
  },
  {
    icon: 'globe' as const,
    title: 'DNS & SSL automation',
    body: 'Zones managed for you and HTTPS certificates issued and renewed automatically, not diarised.',
  },
  {
    icon: 'refresh' as const,
    title: 'Backups & recovery',
    body: 'Scheduled backups of sites, mail and databases, with a documented restore path when it matters.',
  },
  {
    icon: 'shield' as const,
    title: 'Hardening & monitoring',
    body: 'Firewalling, brute-force protection and service monitoring applied as standard on the platform.',
  },
];

const process = [
  {
    title: 'Talk it through',
    body: 'You tell us what you are trying to do. We tell you plainly whether it is something we do well — and if it is not, we say so.',
  },
  {
    title: 'Scope and quote',
    body: 'A written scope with what is included, what is not, and what it costs. Standard hosting plans skip this entirely — the pricing is already published.',
  },
  {
    title: 'Build and deploy',
    body: 'Work is reviewed before it goes live. Infrastructure changes are made in a way we can roll back, not improvised on the box.',
  },
  {
    title: 'Support and iterate',
    body: 'You keep direct access to the people who did the work — for changes, questions, or the thing that broke at an inconvenient hour.',
  },
];

const faqs = [
  {
    q: 'Where are your servers?',
    a: 'We run our hosting on infrastructure we manage ourselves, and we are happy to tell you exactly where a given service is hosted before you sign up. Ask us and you will get a straight answer rather than a marketing map.',
  },
  {
    q: 'Can I see pricing without talking to sales?',
    a: 'Yes. Hosting plans and pricing are published in our client portal at billing.logixhare.com, and you can sign up there directly. Project work — websites, network jobs — is quoted, because the scope genuinely varies.',
  },
  {
    q: 'Do you help move an existing site to you?',
    a: 'Yes, migration is part of onboarding. Send us access to where the site lives now and we will handle moving the files, database, mail and DNS, and tell you honestly if anything about the current setup will not carry over cleanly.',
  },
  {
    q: 'Who actually answers when I have a problem?',
    a: 'The people who run the platform. LogiXhare is a small technical team by design — there is no tier-one script between you and someone who can fix the thing.',
  },
  {
    q: 'Do you work with clients outside Dhaka?',
    a: 'Yes. Hosting and remote infrastructure work are location-independent, and we work with clients across Bangladesh. On-site work is arranged case by case.',
  },
];
---

<BaseLayout
  title="Home"
  description="LogiXhare Technologies — managed web hosting, custom software and ERP, web development, IT and networking, cloud and data centre, and cyber security services, built and supported from Dhaka, Bangladesh."
>
  <!-- ===================== HERO ===================== -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-grid-lines" aria-hidden="true"></div>

    <div class="container hero-inner">
      <div class="hero-copy">
        <div class="hero-slides" id="hero-slides">
          {
            slides.map((slide, i) => (
              <article class="hero-slide" data-slide={i} aria-hidden={i !== 0 ? 'true' : 'false'}>
                <p class="eyebrow">{slide.eyebrow}</p>
                <h1 class="display">{slide.heading}</h1>
                <p class="lede">{slide.body}</p>
              </article>
            ))
          }
        </div>

        <div class="hero-actions">
          <a href={url('/contact/')} class="btn btn-primary">
            Contact us <Icon name="arrow-right" class="btn-icon" />
          </a>
          <a href={url('/services/')} class="btn btn-ghost">Explore our services</a>
        </div>

        <div class="hero-dots" role="tablist" aria-label="Hero slides">
          {
            slides.map((slide, i) => (
              <button
                type="button"
                class="hero-dot"
                role="tab"
                data-dot={i}
                aria-selected={i === 0 ? 'true' : 'false'}
              >
                <span class="visually-hidden">{slide.eyebrow}</span>
              </button>
            ))
          }
        </div>
      </div>

      <div class="hero-art" aria-hidden="true">
        <div class="hero-art-panel">
          {
            slides.map((slide, i) => (
              <img
                class="hero-art-img"
                data-art={i}
                data-active={i === 0 ? 'true' : 'false'}
                src={url(artFor.get(slide.art)?.image ?? '')}
                alt=""
                width="640"
                height="400"
                loading="eager"
                decoding="async"
              />
            ))
          }
        </div>
      </div>
    </div>

    <!-- What every plan includes — the honest version of a stats bar. -->
    <div class="container">
      <ul class="standards">
        {
          standards.map((item) => (
            <li class="standard">
              <span class="standard-icon">
                <Icon name={item.icon} />
              </span>
              <div>
                <strong>{item.title}</strong>
                <small>{item.note}</small>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ===================== STACK STRIP ===================== -->
  <section class="stack-strip">
    <div class="container stack-inner">
      <p class="stack-label">Built on infrastructure you already trust</p>
      <ul class="stack-list">
        {stack.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <!-- ===================== SERVICES ===================== -->
  <section class="section" id="services">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Services</p>
        <h2>Services we offer</h2>
        <p class="lede">
          From the server your site runs on to the software your staff use all day — eight areas of
          work, staffed by engineers who do the job themselves rather than sub it out.
        </p>
      </div>

      <div class="services-grid">
        {
          services.map(({ cat, ...service }, i) => (
            <ServiceCard
              {...service}
              image={artFor.get(cat)?.image}
              imageAlt={artFor.get(cat)?.imageAlt}
              eager={i < 3}
            />
          ))
        }

        <a class="services-all card" href={url('/services/')}>
          <span class="services-all-count">{serviceCount}</span>
          <h3>services in full</h3>
          <p>
            Every service across all eight areas, with what each one actually involves — and what it
            does not.
          </p>
          <span class="services-all-icons" aria-hidden="true">
            {/* line: these sit bare on the tile, without a chip each. */}
            {serviceCategories.map((c) => <Icon name={c.icon} line />)}
          </span>
          <span class="services-all-link">
            See all services <Icon name="arrow-right" class="btn-icon" />
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== WHO WE BUILD FOR ===================== -->
  <section class="section band">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Industries</p>
        <h2>Industries we serve</h2>
        <p class="lede">
          The same infrastructure discipline, scoped to what each sector actually needs — because a
          hospital, a factory and an ISP do not run the same systems.
        </p>
      </div>

      <div class="industry-grid">
        {
          industries.map((item) => (
            <article class="industry-card card">
              <span class="icon-tile">
                <Icon name={item.icon} />
              </span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== THE PLATFORM ===================== -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The platform</p>
        <h2>What you are actually buying</h2>
        <p class="lede">
          Not a reseller account with someone else's name on the support desk. This is the platform
          we build, run and answer for ourselves.
        </p>
      </div>

      <div class="platform-grid">
        {
          platform.map((p) => (
            <article class="platform-item">
              <span class="platform-icon">
                <Icon name={p.icon} />
              </span>
              <div>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== HOSTING TEASER ===================== -->
  <section class="section band">
    <div class="container hosting-inner">
      <div class="hosting-copy">
        <p class="eyebrow">Web hosting</p>
        <h2>Four tiers. Published pricing. No quote required.</h2>
        <p class="lede">
          Hosting scales from a single first website up to a busier site or small application. Every
          tier includes free SSL, business email on your domain, and the same support.
        </p>
        <div class="hosting-actions">
          <a
            href="https://billing.logixhare.com/"
            class="btn btn-primary"
            target="_blank"
            rel="noopener noreferrer"
          >
            See plans & pricing <Icon name="arrow-right" class="btn-icon" />
          </a>
          <a href={url('/services/#web-hosting')} class="btn btn-ghost">What's included</a>
        </div>
      </div>

      <ul class="tier-list">
        <li>
          <span class="tier-name">Go</span><span class="tier-note">A first website, done properly.</span>
        </li>
        <li>
          <span class="tier-name">Starter</span><span class="tier-note">More disk and bandwidth to grow into.</span>
        </li>
        <li>
          <span class="tier-name">Medium</span><span class="tier-note">Busier sites and small applications.</span>
        </li>
        <li>
          <span class="tier-name">Advanced</span><span class="tier-note">Our largest shared tier.</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ===================== PROCESS ===================== -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">How we work</p>
        <h2>What working with us looks like</h2>
        <p class="lede">
          Four steps, in this order. The numbering is the actual sequence, not decoration.
        </p>
      </div>

      <ol class="process-grid">
        {
          process.map((step, i) => (
            <li class="process-step">
              <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="section band">
    <div class="container faq-inner">
      <div class="faq-head">
        <p class="eyebrow">FAQs</p>
        <h2>Questions worth asking</h2>
        <p class="lede">
          The things people ask before signing up — answered straight, including where the answer is
          "ask us".
        </p>
        <a href={url('/contact/')} class="btn btn-ghost faq-cta">Ask us something else</a>
      </div>

      <div class="faq-list">
        {
          faqs.map((faq, i) => (
            <details class="faq-item" open={i === 0}>
              <summary>
                {faq.q}
                <Icon name="chevron-down" class="faq-chevron" />
              </summary>
              <p>{faq.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    heading="Ready to move your site somewhere it gets looked after?"
    body="Tell us what you're running today. We'll tell you plainly what we'd change, what it costs, and whether it's worth doing at all."
  />
</BaseLayout>

<style>
  /* ===================== HERO ===================== */

  .hero {
    position: relative;
    padding-block: clamp(3rem, 2rem + 4vw, 6rem) clamp(2.5rem, 2rem + 2vw, 4rem);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: -30% -20% auto -20%;
    height: 900px;
    background:
      radial-gradient(ellipse 60% 50% at 20% 25%, rgba(45, 199, 201, 0.16), transparent 70%),
      radial-gradient(ellipse 50% 45% at 82% 12%, rgba(45, 130, 201, 0.14), transparent 70%);
    pointer-events: none;
  }

  .hero-grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, #000 30%, transparent 75%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    align-items: center;
    gap: clamp(2rem, 4vw, 4rem);
  }

  /* Slides stack in the same grid cell so the hero never jumps height. */
  .hero-slides {
    display: grid;
  }

  .hero-slide {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity 0.5s ease, transform 0.5s ease, visibility 0.5s;
  }

  .hero-slide[aria-hidden='false'] {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .hero-slide h1 {
    margin-top: 1.1rem;
  }

  .hero-slide .lede {
    margin-top: 1.4rem;
    max-width: 54ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2.2rem;
  }

  .hero-dots {
    display: flex;
    gap: 0.5rem;
    margin-top: 2.1rem;
  }

  .hero-dot {
    width: 34px;
    height: 4px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--line);
    cursor: pointer;
    transition: background-color 0.25s ease, width 0.25s ease;
  }

  .hero-dot[aria-selected='true'] {
    background: var(--teal);
    width: 52px;
  }

  .hero-art {
    display: flex;
    justify-content: center;
  }

  .hero-art-panel {
    position: relative;
    width: 100%;
    max-width: 460px;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: linear-gradient(155deg, #0b1c31, #0e2740 60%, #081524);
    overflow: hidden;
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.9);
  }

  /* All four stack in the same box and cross-fade, so the artwork changes with
     the slide instead of one static image sitting under rotating copy. */
  /* Scaled past the frame: the artwork's subject sits mid-canvas with margin
     around it, which reads as too small in a panel this size. */
  .hero-art-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.28);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .hero-art-img[data-active='true'] {
    opacity: 1;
    transform: scale(1.2);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-art-img,
    .hero-art-img[data-active='true'] {
      transition: opacity 0.2s ease;
      transform: scale(1.2);
    }
  }

  /* --- standards strip --- */

  .standards {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(3rem, 2.4rem + 2vw, 4.5rem);
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .standard {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1.35rem 1.4rem;
    background: var(--surface);
  }

  .standard-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 9px;
    background: var(--chip-bg);
    box-shadow: var(--chip-inset);
    border: 1px solid var(--chip-line);
    color: var(--chip-ink);
    flex-shrink: 0;
  }

  .standard-icon :global(svg) {
    width: 26px;
    height: 26px;
  }

  .standard strong {
    display: block;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--text);
  }

  .standard small {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.8rem;
    color: var(--text-soft);
    line-height: 1.45;
  }

  /* ===================== STACK STRIP ===================== */

  .stack-strip {
    border-block: 1px solid var(--line);
    background: var(--bg-alt);
  }

  .stack-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.25rem 2rem;
    padding-block: 1.5rem;
  }

  .stack-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-soft);
  }

  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 0.75rem;
  }

  .stack-list li {
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  /* ===================== SERVICES ===================== */

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  /* The ninth tile: eight categories plus this one fill a 3x3 grid exactly. */
  /* Shares the grid with the service cards, so it is centred the same way. */
  .services-all {
    display: flex;
    flex-direction: column;
